{
  "name": "astro-my-profile",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "husky:install": "husky install .husky",
    "dev": "dotenvx run -- astro dev",
    "start": "dotenvx run -- astro dev",
    "build": "run-p test astro:build",
    "preview": "dotenvx run -- astro preview",
    "astro": "astro",
    "astro:build": "dotenvx run -- astro build",
    "deploy": "run-s astro:build cf:deploy",
    "cf:deploy": "node scripts/prepare-cloudflare-assetsignore.mjs && dotenvx run -- wrangler deploy",
    "cf:preview": "dotenvx run -- wrangler dev",
    "cf:logs": "dotenvx run -- wrangler tail --format pretty",
    "env:encrypt": "dotenvx encrypt",
    "env:decrypt": "dotenvx decrypt",
    "test": "run-p test:*",
    "test:eslint": "eslint .",
    "test:prettier": "prettier --check --cache './**/*.{js,mjs,cjs,jsx,ts,tsx,astro,json,css,yml,yaml}'",
    "test:astro": "astro check",
    "format": "run-s format:*",
    "format:write": "prettier --write --cache './**/*.{js,mjs,cjs,jsx,ts,tsx,astro,json,css,yml,yaml}'",
    "format:eslint": "eslint --fix .",
    "ncu": "ncu -u"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7",
    "@tailwindcss/vite": "4.3.3",
    "ansi-align": "3",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.11.10",
    "eslint-plugin-astro": "^1.6",
    "husky": "^9.1",
    "lint-staged": "^17",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9",
    "prettier-plugin-astro": "^0.14",
    "prettier-plugin-tailwindcss": "^0.8",
    "string-width": "8",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^12.6.13",
    "@radix-ui/colors": "^3.0.0",
    "@types/node": "^26",
    "astro": "^5.18.2",
    "eslint-config-flat-gitignore": "^2.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.1"
  }
}
